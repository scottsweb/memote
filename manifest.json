{
	"content_scripts": [
		{
			"js": ["js/site-loader.js", "js/spatial-navigation.js"],
			"matches": ["<all_urls>"],
			"css": ["css/memote-default.css"],
			"run_at": "document_end"
		}
	],
	"background": {
		"service_worker": "js/background.js"
	},
	"icons": {
		"16": "img/icon16.png",
		"32": "img/icon32.png",
		"64": "img/icon64.png"
	},
	"description": "Memote - Control and navigate popular streaming sites with a remote or keyboard.",
	"manifest_version": 3,
	"name": "Memote",
	"permissions": ["storage"],
	"host_permissions": ["<all_urls>"],
	"web_accessible_resources": [
		{
			"resources": ["sites.json", "css/sites/*.css", "js/sites/*.js"],
			"matches": ["<all_urls>"]
		}
	],
	"short_name": "memote",
	"version": "0.7.0",
	"options_page": "options.html"
}
